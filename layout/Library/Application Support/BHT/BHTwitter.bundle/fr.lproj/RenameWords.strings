/*
Generic terminology replacements for the "Restore Twitter names" feature, applied
to every localized string and to server-composed text (notification rows etc.).

Lowercase keys match the original, initial-capital, and all-capital spellings
using the app language for casing ("Reposts" -> "Retweets", "REPOST" -> "RETWEET").
A replacement carrying its own capital keeps it even for lowercase matches
("posted" -> "Tweeted"). Keys that contain an uppercase letter match exactly and
are replaced verbatim ("X" -> "Twitter").
List each word in only one of the two forms, and never use a replacement value that
matches another key — replacements must be stable if the text is processed twice.

Latin words require word boundaries; Japanese/Chinese terms can touch adjacent
characters. For changes that depend on grammar or meaning, 
use a complete RenamePhrases.strings entry (exact source text) 
or RenameOverrides.strings entry (app localization key). Avoid generic
verbs such as "publish" that also apply to other kinds of content.

Strictly per-language: a language without its own copy of this file gets no generic
renaming at all.
*/

"repost" = "retweet";
"reposts" = "retweets";
"reposté" = "retweeté";
"republication en cours" = "retweet en cours";
"post" = "Tweet";
"posts" = "Tweets";
"posté" = "Tweeté";
"poster" = "Tweeter";
"publication en cours" = "Tweet en cours";
"Premium" = "Blue";
"X" = "Twitter";
